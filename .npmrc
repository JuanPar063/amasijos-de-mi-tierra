# Capacitor descubre los plugins nativos leyendo node_modules. Con los enlaces
# simbólicos que pnpm usa por defecto, `cap sync` a veces no encuentra los
# plugins (@capacitor-community/sqlite, filesystem, share). 'hoisted' aplana
# node_modules como el npm clásico y evita ese problema al generar el APK.
# Tras cambiar esto hay que reinstalar: `pnpm install`.
node-linker=hoisted
